PORT=4000
NODE_ENV=production
CORS_ORIGINS=https://roxylabs-two.vercel.app
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Temporary Play audio storage (private Supabase bucket)
ROXY_PLAY_BUCKET=roxy-play
ROXY_PLAY_MAX_BYTES=31457280
# Provider must return { audioUrl, title? } for audio you own or are authorized to use
ROXY_AUDIO_PROVIDER_URL=https://your-authorized-audio-provider.example/process
ROXY_AUDIO_PROVIDER_TOKEN=

# Public Vercel domain used in returned Play download links (no trailing slash)
PLAY_PUBLIC_BASE_URL=https://roxylabs.vercel.app
