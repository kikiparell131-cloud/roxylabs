PORT=4000
NODE_ENV=production
CORS_ORIGINS=https://roxylabs-two.vercel.app
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Temporary Play audio storage (private Supabase bucket)
ROXY_PLAY_BUCKET=roxy-play
ROXY_PLAY_MAX_BYTES=31457280
# Audio conversion uses the SaveTube integration in backend/api/play.js.

# Public Vercel domain used in returned Play download links (no trailing slash)
PLAY_PUBLIC_BASE_URL=https://roxylabs.vercel.app
