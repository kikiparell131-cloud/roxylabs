# Vercel frontend environment variables
NEXT_PUBLIC_API_URL=https://YOUR-RAILWAY-SERVICE.up.railway.app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_ADMIN_WHATSAPP=628XXXXXXXXXX

# Railway backend environment variables
PORT=4000
CORS_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app,http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# IMPORTANT: backend requires the Supabase service_role key, NOT the anon/public key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
